# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Auto-generated by Next.js on dev/build — not hand-maintained.
/AGENTS.md
/CLAUDE.md

# Font binaries. Work Sans is OFL and safe to track. Block Berthold is a
# commercial Adobe/Berthold face and Bantayog Sans shipped no licence at all —
# both stay out of git until terms are confirmed, because a commercial binary is
# much easier to keep out of a repo than to remove from its history. Get them
# from the Proyekto resources section. See public/fonts/README.md.
/public/fonts/BlockBerthold.woff2
/public/fonts/BantayogSans-*.woff2
/public/fonts/GoodDogCool.woff2
/public/fonts/GoodDogPlain.woff2

# Client media library. Lives in Google Drive today and moves into the CMS
# media library at launch — it does not belong in git.
/public/media/
