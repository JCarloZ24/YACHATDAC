# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Auto-generated by Next.js on dev/build — not hand-maintained.
/AGENTS.md
/CLAUDE.md

# Font binaries. Work Sans is OFL and safe to track. Bantayog Sans is now
# tracked too: R4 closed 2 Sep 2026 with a commercial licence, and this repo is
# private, so the binaries are not being redistributed — they have to be in git
# for Vercel to serve them at all (they 404'd in prod until 7 Sep 2026). If this
# repo is ever made public, remove them from history and serve them from private
# storage instead. Good Dog is freeware and safe to track once supplied.
# Block Berthold stays out: the Adobe Fonts kit qqn2php serves it in production,
# so the local woff2 is an outage fallback only and is never needed by a build.
# See public/fonts/README.md.
/public/fonts/BlockBerthold.woff2

# Client media library. Originally kept out of git (source of truth is Google
# Drive, moving to the CMS media library at launch), but the Vercel deployment
# builds from this repo, so the site's rendered copies are tracked until the
# CMS exists — an untracked library deploys a site with no photographs.
# The Drive originals remain the source of truth; this is the web-sized set.

# Raw Drive-export copies of the client prototypes, with their base64
# photography extracted to disk. JC's converted versions — provenance header,
# governance circle, `[ Image — … ]` markers in place of the photos — are the
# ones in docs/content/drafts/. Per STATUS note 12 the photography is
# placeholder direction, not an asset manifest, so it stays out of git.
/docs/content/drafts/.drive-export-raw/

# local dev server log
/dev.log

# Brand source-of-truth folder (see brand/README.md).
# Photography and video are client media — same reasoning as /public/media/ above:
# they live in Drive today and move into the CMS at launch.
/brand/photography/
# Video masters are excluded, but the README explaining how to transcode them is not —
# hence the glob + negation rather than ignoring the directory itself.
/brand/video/*
!/brand/video/README.md
# Source font masters. These mirror /public/fonts/ but are never served, so a
# build never needs them and there is nothing to gain by tracking the binaries;
# the served copies under /public/fonts/ are the ones in git.
/brand/typefaces/BlockBerthold.woff2
/brand/typefaces/BantayogSans-*.woff2
/brand/typefaces/GoodDog*.woff2
/brand/typefaces/GOODD*.TTF

# Playwright MCP session dumps — regenerated per run
.playwright-mcp/
