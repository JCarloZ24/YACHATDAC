# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Auto-generated by Next.js on dev/build — not hand-maintained.
/AGENTS.md
/CLAUDE.md

# Font binaries are licensed assets. Track them only once licence terms are
# confirmed with the brand team (see public/fonts/README.md).
/public/fonts/*
!/public/fonts/README.md

# Client media library. Lives in Google Drive today and moves into the CMS
# media library at launch — it does not belong in git.
/public/media/
